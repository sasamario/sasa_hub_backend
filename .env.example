# NestJSアプリのポート(フロントエンドの3000と衝突しないよう3001を使用)
PORT=3001

# PostgreSQL接続情報
POSTGRES_USER=sasa_hub
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sasa_hub

# Prismaが参照する接続文字列(上記POSTGRES_*と値を合わせる。ホスト名はcompose上のサービス名`db`)
DATABASE_URL=postgresql://sasa_hub:change_me@db:5432/sasa_hub

# pgAdminのログイン情報
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# --- GitHub連携 ---
# 同期対象リポジトリ(owner/repo形式、カンマ区切り)
GITHUB_TRACKED_REPOSITORIES=owner/repo1,owner/repo2

# --- Qiita連携 ---
# アクセストークン(認証用)
QIITA_ACCESS_TOKEN=change_me
# 自分の記事に絞り込むためのユーザー名
QIITA_USERNAME=your_qiita_username